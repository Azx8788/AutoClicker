<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="4dp">

        <Spinner android:id="@+id/sp_type"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/et_label"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="名称"/>
        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal">
            <EditText android:id="@+id/et_x" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:hint="X" android:inputType="number"/>
            <EditText android:id="@+id/et_y" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:hint="Y" android:inputType="number"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal">
            <EditText android:id="@+id/et_x2" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:hint="终点X" android:inputType="number"/>
            <EditText android:id="@+id/et_y2" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:hint="终点Y" android:inputType="number"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal">
            <EditText android:id="@+id/et_interval" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:hint="间隔ms(≥20)" android:inputType="number"/>
            <EditText android:id="@+id/et_press" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:hint="时长ms" android:inputType="number"/>
            <EditText android:id="@+id/et_repeat" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:hint="次数(0不限)" android:inputType="number"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
