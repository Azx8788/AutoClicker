<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="自动点击器"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="无障碍服务：未开启"
            android:textSize="14sp"
            android:layout_marginTop="6dp"/>

        <TextView
            android:id="@+id/clicker_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="当前共 0 个点击器"
            android:textSize="14sp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp"/>

        <Button android:id="@+id/btn_add"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="＋ 添加点击器"
            android:textSize="16sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/btn_remove"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="－ 减少点击器"/>
            <Button android:id="@+id/btn_params"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="⚙ 点击器参数"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">
            <Button android:id="@+id/btn_show_panel"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="显示悬浮窗"
                android:textSize="14sp"/>
            <Button android:id="@+id/btn_close_panel"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="关闭悬浮窗"
                android:textSize="14sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="悬浮窗按钮排列："
            android:textSize="14sp"
            android:layout_marginTop="14dp"/>

        <RadioGroup android:id="@+id/rg_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton android:id="@+id/rb_v"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="竖排"/>
            <RadioButton android:id="@+id/rb_h"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="横排"/>
            <RadioButton android:id="@+id/rb_min"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="极简"/>
        </RadioGroup>

        <TextView android:id="@+id/alpha_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="悬浮窗透明度 70%"
            android:textSize="14sp"
            android:layout_marginTop="8dp"/>

        <SeekBar android:id="@+id/seek_alpha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <CheckBox android:id="@+id/cb_touch_stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="运行时点击屏幕立即停止连点"
            android:textSize="14sp"
            android:layout_marginTop="8dp"/>

        <Button android:id="@+id/btn_shizuku"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="⚡ Shizuku 一键授权（无障碍+悬浮窗）"
            android:textSize="14sp"/>

        <Button android:id="@+id/btn_open_acc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="打开无障碍设置"
            android:textSize="14sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="使用方法：&#10;1. Shizuku 一键授权（自动开无障碍+悬浮窗权限）&#10;2. 用【添加点击器】准备好点击器，拖动屏幕上的编号圆点到目标位置&#10;3. 点【显示悬浮窗】调出小控制条：▶ 开始/停止，✕ 关闭&#10;4. 用【点击器参数】调整每个点击器的间隔/时长/次数&#10;&#10;悬浮窗排列：竖排/横排（▶ ✕）或极简（仅 ▶，拖动可移动，关闭用本页【关闭悬浮窗】）&#10;&#10;紧急停止（运行中）：&#10;· 点击屏幕（可在上方关闭）&#10;· 按【音量减键】&#10;· 触碰悬浮窗（控制条）&#10;· 按电源键息屏&#10;· 下拉通知栏点【停止连点】"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="4dp"/>

    </LinearLayout>
</ScrollView>
