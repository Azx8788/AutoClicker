<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:padding="12dp">

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="无障碍服务：未开启"
        android:textSize="14sp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button android:id="@+id/btn_add"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="＋ 添加点"/>
        <Button android:id="@+id/btn_run"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="▶ 开始"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <Button android:id="@+id/btn_float"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="悬浮窗"/>
        <Button android:id="@+id/btn_open_acc"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="无障碍设置"/>
    </LinearLayout>

    <Button android:id="@+id/btn_shizuku"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="⚡ Shizuku 一键授权（自动开启无障碍）"/>
</LinearLayout>
